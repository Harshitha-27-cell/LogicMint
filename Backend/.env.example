# MongoDB connection string
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/LogicMint?retryWrites=true&w=majority

# Server port
PORT=4000

# JWT secret for access & refresh tokens
SECRET_KEY=your_secret_key_here

# Optional: OpenAI for AI assistant
OPENAI_API_KEY=

# Optional: Cloudinary (for profile uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
