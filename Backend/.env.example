# MongoDB connection string
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/LogicMint?retryWrites=true&w=majority

# Server port
PORT=4000

# JWT secret for access & refresh tokens
SECRET_KEY=your_secret_key_here

# AI — OpenRouter (recommended) or OpenAI
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Google OAuth (same client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Optional: Cloudinary (for profile uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
